{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://subsidized-meal-test.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/confirm-meals",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/close-cycles",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/expire-orders",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/process-refunds",
      "schedule": "0 12 * * *"
    }
  ]
}
