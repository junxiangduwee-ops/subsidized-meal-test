# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database. Leave DATABASE_URL unset to fall back to SQLite at prisma/dev.db
# (zero setup, development only). Set it to use Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mrdiy_food?schema=public"
DATABASE_URL=""
# On Supabase, also set the direct URL for schema pushes:
# DIRECT_URL="postgresql://postgres:postgres@db.<ref>.supabase.co:5432/postgres"

# Optional override; normally inferred from the URL scheme. sqlite | postgresql
# DATABASE_PROVIDER=""

# Base URL of this app — used for HitPay redirect + webhook callbacks.
# Must be reachable by HitPay (no localhost). Use a tunnel for local testing.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS="12"

# ---------------------------------------------------------------------------
# HitPay — Entity-based credentials
#
# Each legal entity has its own HitPay account. Credentials are stored in the
# database (encrypted with HITPAY_ENCRYPTION_KEY) and managed via
# Admin → Companies → Entities.
#
# HITPAY_ENCRYPTION_KEY is REQUIRED. Generate with:
#   openssl rand -hex 32
# Keep this secret and back it up — losing it makes all stored keys unreadable.
# ---------------------------------------------------------------------------
HITPAY_ENCRYPTION_KEY=""

# Global defaults (used when no entity-specific override is set)
HITPAY_MODE="sandbox"              # "sandbox" or "live"
HITPAY_CURRENCY="MYR"
HITPAY_PAYMENT_METHODS="touch_n_go,duitnow"

# Entity-specific credentials (optional — set via Admin UI instead)
# Replace <ENTITY> with the entity code in uppercase: TRADING, INTERNATIONAL,
# ECOMMERCE, GROUP. Leave blank to use the Admin UI for all entities.
#
# HITPAY_API_KEY_TRADING=""
# HITPAY_SALT_TRADING=""
# HITPAY_MODE_TRADING="sandbox"
#
# HITPAY_API_KEY_INTERNATIONAL=""
# HITPAY_SALT_INTERNATIONAL=""
# HITPAY_MODE_INTERNATIONAL="sandbox"
#
# HITPAY_API_KEY_ECOMMERCE=""
# HITPAY_SALT_ECOMMERCE=""
# HITPAY_MODE_ECOMMERCE="sandbox"
#
# HITPAY_API_KEY_GROUP=""
# HITPAY_SALT_GROUP=""
# HITPAY_MODE_GROUP="sandbox"

# ---------------------------------------------------------------------------
# Ordering window defaults (can be overridden per cycle in the Admin UI)
# ---------------------------------------------------------------------------
# Day of week ordering closes. 1=Mon ... 7=Sun (3 = Wednesday)
ORDER_CUTOFF_WEEKDAY="3"
ORDER_CUTOFF_HOUR="17"
ORDER_CUTOFF_MINUTE="0"
# IANA timezone used for all cycle/cutoff math
APP_TIMEZONE="Asia/Kuala_Lumpur"

# ---------------------------------------------------------------------------
# Cron job security
# Generate with: openssl rand -hex 32
# Vercel cron requests are signed with this value in the Authorization header.
# For self-hosted deployments, pass it as: Authorization: Bearer <value>
# ---------------------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Optional: LDAP / Active Directory  (leave AUTH_LDAP_ENABLED=false to skip)
# ---------------------------------------------------------------------------
AUTH_LDAP_ENABLED="false"
LDAP_URL="ldaps://ldap.example.com:636"
LDAP_BIND_DN="CN=svc-food,OU=Service Accounts,DC=example,DC=com"
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE="OU=Users,DC=example,DC=com"
LDAP_SEARCH_FILTER="(&(objectClass=user)(mail={{email}}))"
LDAP_ATTR_NAME="displayName"
LDAP_ATTR_STAFF_ID="employeeID"
LDAP_ATTR_DEPARTMENT="department"

# ---------------------------------------------------------------------------
# Optional: OIDC / SSO — e.g. Entra ID / Azure AD  (leave disabled to skip)
# Register redirect URI: {APP_URL}/api/auth/oidc/callback
# ---------------------------------------------------------------------------
AUTH_OIDC_ENABLED="false"
OIDC_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid profile email"

# ---------------------------------------------------------------------------
# Optional: Joget SSO embedded mode (/api/auth/joget-identify)
# Always active when AUTH_JOGET_SSO_ENABLED=true. Maps Joget group names to
# app roles (case-insensitive). Priority: Admin > Finance > Analytics >
# Reception > User. Anyone in no recognised group falls back to User.
# Pass companyCode=<code> in the SSO URL to auto-assign the user's company.
# ---------------------------------------------------------------------------
AUTH_JOGET_SSO_ENABLED="false"
JOGET_SSO_SECRET=""
JOGET_SSO_ISSUER="joget"
JOGET_SSO_AUDIENCE="food-ordering-app"
JOGET_GROUP_ROLE_MAP="Admin:ADMIN,Finance:FINANCE,Analytics:ANALYTICS,Reception:RECEPTION"

# ---------------------------------------------------------------------------
# Seed data (only used by `npm run db:seed`)
# ---------------------------------------------------------------------------
# REQUIRED when seeding a remote/hosted database — the default is published
# in this README so a public deployment seeded with it has a known admin login.
SEED_DEFAULT_PASSWORD="ChangeMe123!"
