# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database. Leave DATABASE_URL unset to fall back to SQLite at prisma/dev.db
# (zero setup, development only). Set it to use Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mrdiy_food?schema=public"
DATABASE_URL=""
# Optional override; normally inferred from the URL scheme. sqlite | postgresql
# DATABASE_PROVIDER=""

# Base URL of this app - used for HitPay redirect + webhook callbacks.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
SESSION_TTL_HOURS="12"

# ---------------------------------------------------------------------------
# HitPay  (https://dashboard.hit-pay.com -> Settings -> Payment Gateway -> API Keys)
# ---------------------------------------------------------------------------
HITPAY_API_KEY=""
HITPAY_SALT=""
# "sandbox" or "live"
HITPAY_MODE="sandbox"
HITPAY_CURRENCY="MYR"

# ---------------------------------------------------------------------------
# Ordering window defaults (can be overridden per cycle in the Admin UI)
# ---------------------------------------------------------------------------
# Day of week ordering closes in the ordering week. 1=Mon ... 7=Sun
ORDER_CUTOFF_WEEKDAY="3"
ORDER_CUTOFF_HOUR="17"
ORDER_CUTOFF_MINUTE="0"
# IANA timezone used for all cycle/cutoff math
APP_TIMEZONE="Asia/Kuala_Lumpur"

# ---------------------------------------------------------------------------
# Optional: LDAP  (leave AUTH_LDAP_ENABLED=false to disable)
# ---------------------------------------------------------------------------
AUTH_LDAP_ENABLED="false"
LDAP_URL="ldaps://ldap.example.com:636"
LDAP_BIND_DN="CN=svc-food,OU=Service Accounts,DC=example,DC=com"
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE="OU=Users,DC=example,DC=com"
LDAP_SEARCH_FILTER="(&(objectClass=user)(mail={{email}}))"
LDAP_ATTR_NAME="displayName"
LDAP_ATTR_STAFF_ID="employeeID"
LDAP_ATTR_DEPARTMENT="department"

# ---------------------------------------------------------------------------
# Optional: OIDC / SSO  (leave AUTH_OIDC_ENABLED=false to disable)
# ---------------------------------------------------------------------------
AUTH_OIDC_ENABLED="false"
OIDC_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_SCOPES="openid profile email"

# ---------------------------------------------------------------------------
# Optional: Joget account login  (leave AUTH_JOGET_ENABLED=false to disable)
#
# Users type their Joget email/password into this app's normal login form;
# this app calls a custom API you expose from Joget's API Builder plugin to
# verify the credential and fetch the user's Joget groups. See
# src/lib/auth/joget.ts for the exact request/response contract expected.
# ---------------------------------------------------------------------------
AUTH_JOGET_ENABLED="false"
# Base URL of your Joget API Builder app, e.g.
# https://joget.example.com/jw/api/build/foodAuth  (no trailing slash)
JOGET_API_URL=""
# API Builder "Manage API Key" credentials for this endpoint.
JOGET_API_KEY=""
JOGET_API_SECRET=""
# Maps Joget group name -> app role. First match by priority
# ADMIN > FINANCE > ANALYTICS wins; unmatched groups default to USER.
JOGET_GROUP_ROLE_MAP="Admin:ADMIN,Finance:FINANCE,Analytics:ANALYTICS"

# ---------------------------------------------------------------------------
# Optional: Joget embedded SSO handoff (leave AUTH_JOGET_SSO_ENABLED=false to disable)
#
# For opening this app inside an iframe from a Joget page the person is
# ALREADY logged into - no second login screen. Joget mints a short-lived
# signed token for the current session's user and points the iframe's src at
# /api/auth/joget-sso?token=... See src/lib/auth/joget-sso.ts for the exact
# token contract (claims, algorithm, TTL) the Joget side must produce.
# ---------------------------------------------------------------------------
AUTH_JOGET_SSO_ENABLED="false"
# 32+ random bytes, shared ONLY with the Joget-side token minter.
# Generate with: openssl rand -base64 48
JOGET_SSO_SECRET=""
JOGET_SSO_ISSUER="joget"
JOGET_SSO_AUDIENCE="food-ordering-app"

# ---------------------------------------------------------------------------
# Seed data (only used by `npm run db:seed`)
# ---------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD="ChangeMe123!"
