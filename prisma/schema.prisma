// MR DIY Food Ordering System
//
// Money convention: every monetary column is an INTEGER number of *sen*
// (1 MYR = 100 sen). Integers avoid float drift and Decimal serialisation
// headaches across the server/client boundary. Format with lib/money.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Queries. On Supabase/Neon this is the transaction pooler (pgbouncer).
  url       = env("DATABASE_URL")
  // Schema changes. `db push` and migrations cannot run through a
  // transaction-mode pooler, so they need a direct/session connection.
  // scripts/prisma.mjs defaults this to DATABASE_URL when it is unset, so a
  // plain unpooled Postgres still works with only one variable.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ANALYTICS
  FINANCE
  RECEPTION
  USER
}

enum AuthProvider {
  LOCAL
  LDAP
  OIDC
  JOGET
}

/// DRAFT      - admin is still planning; invisible to users
/// PUBLISHED  - menu is locked-in and the ordering window is open
/// CLOSED     - cutoff passed; no further orders, kitchen counts are final
/// FULFILLED  - service week finished
/// CANCELLED  - cycle abandoned; paid orders must be refunded
enum CycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  FULFILLED
  CANCELLED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

/// CART             - user is still building the order, nothing committed
/// AWAITING_PAYMENT - HitPay request created, waiting for webhook
/// PAID             - payment confirmed
/// CANCELLED        - user or admin cancelled before payment
/// REFUNDED         - money returned after payment
enum OrderStatus {
  CART
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// PERCENTAGE     - company pays `value` percent of the line price
/// FIXED_PER_ITEM - company pays up to `value` sen off each item
/// FIXED_PER_DAY  - company pays up to `value` sen across all items on one day
enum SubsidyType {
  PERCENTAGE
  FIXED_PER_ITEM
  FIXED_PER_DAY
}

enum SubsidyScope {
  ALL
  DEPARTMENT
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  /// Optional so an employee with no email account can still be provisioned
  /// off their employee code alone (see staffId). App code enforces "at
  /// least one of email or staffId" on every create/provision path - see
  /// lib/auth.ts and admin/users/actions.ts.
  email        String?      @unique
  name         String
  /// The employee code - #currentUser.employee.code# on the Joget side.
  /// The one identifier guaranteed to exist for every real employee, so
  /// it's tried first when matching a Joget/directory identity, and is
  /// the required fallback login identifier for anyone without an email.
  staffId      String?      @unique
  department   String?
  role         Role         @default(USER)
  /// Null for LDAP/OIDC accounts - those never hold a local credential.
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  /// External subject id from LDAP (dn) or OIDC (sub).
  externalId   String?
  active       Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// App-owned ordering preference, pre-fills a brand-new cart (see
  /// getOrCreateCart in lib/orders.ts). Deliberately NEVER touched by
  /// provisionFromDirectory() - Joget/LDAP/OIDC have no concept of this at
  /// all, so it must not be treated as identity data the way name/role are.
  /// Null until either an admin sets one (defaultDeliverySiteLocked = true,
  /// see admin/users) or the person has ordered at least once
  /// (defaultDeliverySiteLocked stays false, and it then auto-tracks their
  /// most recent choice - see setDeliverySite in lib/orders.ts).
  defaultDeliverySiteId     String?
  defaultDeliverySite       DeliverySite? @relation("UserDefaultDeliverySite", fields: [defaultDeliverySiteId], references: [id])
  /// true only when an admin explicitly picked a site in Admin -> Users.
  /// While locked, order-time site changes stop auto-updating the default
  /// (see setDeliverySite) - an admin-pinned value is never silently
  /// overwritten by someone ordering for a different site once. Clearing
  /// the field back to blank in Admin -> Users unlocks it again.
  defaultDeliverySiteLocked Boolean       @default(false)

  orders       Order[]
  createdCycles MenuCycle[] @relation("CycleCreatedBy")
  auditLogs    AuditLog[]
  settingsUpdates AppSettings[] @relation("SettingsUpdatedBy")
  /// Deliveries this person (typically RECEPTION) has confirmed as arrived.
  deliveryConfirmations DeliveryConfirmation[] @relation("DeliveryConfirmedBy")

  @@index([role])
  @@index([department])
  @@index([authProvider, externalId])
}

// ---------------------------------------------------------------------------
// Catalogue - owned by ADMIN
// ---------------------------------------------------------------------------

model Restaurant {
  id          String   @id @default(cuid())
  /// Short, stable identifier (e.g. "R-001") admins can put in a CSV/Excel
  /// sheet to select this restaurant - unlike `name`, it never changes when
  /// the business is renamed. Used to validate weekly-menu imports.
  code        String?  @unique
  name        String   @unique
  description String?
  cuisine     String?
  contactName String?
  contactPhone String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dishes      Dish[]

  @@index([active])
}

model Dish {
  id           String   @id @default(cuid())
  restaurantId String
  /// Short, stable identifier (e.g. "D-001"), unique across every dish in
  /// the catalogue (not just within its restaurant). Lets a weekly-menu
  /// CSV/Excel import reference an exact dish without relying on the
  /// (editable) name matching exactly.
  code         String?  @unique
  name         String
  description  String?
  /// Catalogue list price in sen. A MenuItem may override it for one cycle.
  priceSen     Int
  category     String?
  imageUrl     String?
  /// Free-form tags: "halal", "vegetarian", "contains-nuts", ...
  tags         String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@index([active])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Weekly cycle
//
// Timeline for a cycle whose service week starts Monday W:
//   W-2 (any time)  admin drafts the menu
//   W-1 Monday      publish -> ordering opens
//   W-1 Wednesday   cutoff  -> ordering closes, counts sent to restaurants
//   W   Mon..Fri    food served
// ---------------------------------------------------------------------------

model MenuCycle {
  id               String      @id @default(cuid())
  /// Monday 00:00 of the week the food is *served*. Identifies a cycle -
  /// but no longer a hard unique constraint. A CANCELLED cycle keeps its
  /// row (audit trail, refund note) without permanently occupying the
  /// week; only one non-cancelled cycle may exist per week, enforced in
  /// createCycle rather than the database.
  serviceWeekStart DateTime    @db.Date
  title            String?
  status           CycleStatus @default(DRAFT)

  /// Ordering opens (defaults to Monday 00:00 of the week before service).
  orderOpenAt      DateTime
  /// Ordering closes (defaults to Wednesday 17:00 of the week before service).
  orderCutoffAt    DateTime

  publishedAt      DateTime?
  /// Subsidy rules frozen the moment this cycle actually becomes orderable
  /// (orderOpenAt is reached), not when it's merely published - a cycle
  /// can be published days ahead of its order-open date, and a rule
  /// tweaked in that gap should still count since nobody could act on the
  /// menu yet. See lib/orders.ts subsidyRulesForCycle. Every order placed
  /// this week, whichever day, prices off this same frozen set. Null
  /// before opening, or for a cycle that predates this column.
  subsidyRulesSnapshot Json?
  closedAt         DateTime?
  notes            String?

  createdById      String?
  createdBy        User?       @relation("CycleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  days             MenuDay[]
  orders           Order[]
  deliveryConfirmations DeliveryConfirmation[]

  @@index([status])
  @@index([orderOpenAt, orderCutoffAt])
  @@index([serviceWeekStart])
}

model MenuDay {
  id          String   @id @default(cuid())
  cycleId     String
  /// Calendar date within the service week.
  serviceDate DateTime @db.Date
  slot        MealSlot @default(LUNCH)
  note        String?

  cycle       MenuCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  @@unique([cycleId, serviceDate, slot])
  @@index([serviceDate])
}

model MenuItem {
  id          String  @id @default(cuid())
  menuDayId   String
  dishId      String
  /// Price charged for this cycle, in sen. Snapshotted from Dish at add time
  /// so later catalogue edits never change a published menu.
  priceSen    Int
  /// Max portions the restaurant can supply that day. Null = unlimited.
  capacity    Int?
  sortOrder   Int     @default(0)

  menuDay     MenuDay    @relation(fields: [menuDayId], references: [id], onDelete: Cascade)
  dish        Dish       @relation(fields: [dishId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@unique([menuDayId, dishId])
  @@index([dishId])
}

// ---------------------------------------------------------------------------
// Subsidies - the company's contribution, applied before the user pays
// ---------------------------------------------------------------------------

model SubsidyRule {
  id            String       @id @default(cuid())
  name          String
  type          SubsidyType
  /// PERCENTAGE -> whole percent (e.g. 50). Others -> sen.
  value         Int
  /// Optional ceiling in sen. For PERCENTAGE/FIXED_PER_ITEM it caps the
  /// per-item subsidy; for FIXED_PER_DAY it is ignored (value is the cap).
  capSen        Int?
  scope         SubsidyScope @default(ALL)
  /// Required when scope = DEPARTMENT.
  department    String?
  priority      Int          @default(0)
  active        Boolean      @default(true)
  effectiveFrom DateTime?    @db.Date
  effectiveTo   DateTime?    @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([active, scope])
}

/// Where an order's food physically gets sent - one per Order, chosen at
/// checkout. A managed list (not free text) so it can't accumulate typo'd
/// duplicates like "Warehouse A" / "warehouse a".
model DeliverySite {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  /// Users for whom this is the current default (admin-pinned or learned -
  /// see User.defaultDeliverySiteLocked).
  usersDefaultingHere User[] @relation("UserDefaultDeliverySite")
  deliveryConfirmations DeliveryConfirmation[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Delivery confirmation - reception's day-by-day proof that food for a
// given delivery site actually arrived.
//
// One row per (cycle, delivery site, service date), created only once
// reception acts on it - if no row exists, nothing has been confirmed yet.
// A photo is the preferred evidence, but it is optional on purpose: a site
// with no camera on hand, a bad connection, or a browser that refuses the
// upload should never block reception from recording that the food arrived.
// The record itself (who confirmed it, at what time) is what actually
// counts as fulfilment - the photo is supporting evidence layered on top.
// ---------------------------------------------------------------------------
model DeliveryConfirmation {
  id             String   @id @default(cuid())
  cycleId        String
  deliverySiteId String
  /// The calendar day the food was due at this site.
  serviceDate    DateTime @db.Date

  /// Meals/orders expected at confirm time, snapshotted for the audit trail
  /// so a later order cancellation can't quietly rewrite what reception saw.
  expectedMeals  Int      @default(0)
  expectedOrders Int      @default(0)

  /// Null until reception confirms. Presence of this row + receivedAt is
  /// what "fulfilled" means - everything else here is supporting detail.
  receivedAt     DateTime?
  receivedById   String?
  /// Base64 data: URL of the proof-of-delivery photo. Optional - see above.
  /// Kept as plain text so this works on either database connector with no
  /// extra object-storage dependency; the app enforces a size ceiling
  /// before it ever reaches here (see reception/actions.ts).
  photoDataUrl   String?
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cycle          MenuCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  deliverySite   DeliverySite @relation(fields: [deliverySiteId], references: [id], onDelete: Cascade)
  receivedBy     User?        @relation("DeliveryConfirmedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([cycleId, deliverySiteId, serviceDate])
  @@index([cycleId])
  @@index([deliverySiteId])
  @@index([serviceDate])
}

// ---------------------------------------------------------------------------
// Orders
//
// One Order per (user, cycle). It starts as a CART and is checked out once.
// ---------------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  userId         String
  cycleId        String
  status         OrderStatus @default(CART)

  /// Sum of line grossSen (what the food costs before company help).
  grossSen       Int         @default(0)
  /// Sum of line subsidySen (what the company pays).
  subsidySen     Int         @default(0)
  /// grossSen - subsidySen. What the employee pays through HitPay.
  netSen         Int         @default(0)

  /// Snapshot of the subsidy rules applied at checkout, for audit.
  subsidySnapshot Json?

  submittedAt    DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  /// Where this order's food goes. Nullable here only so existing rows
  /// don't break the migration - validateForCheckout requires it before
  /// payment is allowed, so every real (paid) order has one in practice.
  deliverySiteId String?
  deliverySite   DeliverySite? @relation(fields: [deliverySiteId], references: [id])

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle          MenuCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  payments       Payment[]

  @@index([userId, cycleId])
  @@index([status])
  @@index([cycleId, status])
  @@index([paidAt])
  @@index([deliverySiteId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  menuItemId    String
  quantity      Int

  /// Price snapshot at the time the line was added.
  unitPriceSen  Int
  /// unitPriceSen * quantity
  grossSen      Int
  /// Company contribution for the whole line.
  subsidySen    Int      @default(0)
  /// grossSen - subsidySen
  netSen        Int      @default(0)

  /// Denormalised for reporting stability if a menu item is later removed.
  serviceDate   DateTime @db.Date
  dishName      String
  restaurantName String

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, menuItemId])
  @@index([serviceDate])
  @@index([menuItemId])
}

// ---------------------------------------------------------------------------
// Payments (HitPay)
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("hitpay")
  /// HitPay payment_request id.
  requestId         String?       @unique
  /// HitPay payment id, present once the charge settles.
  paymentId         String?
  status            PaymentStatus @default(PENDING)
  amountSen         Int
  currency          String        @default("MYR")
  checkoutUrl       String?
  paymentMethod     String?
  /// Raw webhook body, kept for reconciliation and dispute handling.
  rawPayload        Json?
  failureReason     String?
  /// The email HitPay was told to send the receipt/payment link to for
  /// this one payment - normally the user's own email, but for an
  /// employee with none on file, whatever they typed in at checkout.
  receiptEmail      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Site settings
// ---------------------------------------------------------------------------

/// Singleton row - always read/written by the fixed id in lib/settings.ts.
/// One row for the whole deployment; there is no per-user settings concept.
model AppSettings {
  id                 String   @id
  siteName           String   @default("MR DIY Food Ordering")
  logoUrl            String?
  faviconUrl         String?
  supportEmail       String?
  /// Optional banner shown to every signed-in user (e.g. planned downtime).
  /// Null/empty means no banner.
  maintenanceMessage String?
  updatedAt          DateTime @updatedAt
  updatedById        String?

  updatedBy          User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
