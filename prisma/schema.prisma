// MR DIY Food Ordering System
//
// Money convention: every monetary column is an INTEGER number of *sen*
// (1 MYR = 100 sen). Integers avoid float drift and Decimal serialisation
// headaches across the server/client boundary. Format with lib/money.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ANALYTICS
  FINANCE
  RECEPTION
  USER
}

enum AuthProvider {
  LOCAL
  LDAP
  OIDC
  JOGET
}

enum CycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  FULFILLED
  CANCELLED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

enum OrderStatus {
  CART
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SubsidyType {
  PERCENTAGE
  FIXED_PER_ITEM
  FIXED_PER_DAY
}

enum SubsidyScope {
  ALL
  DEPARTMENT
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  email        String?      @unique
  name         String
  staffId      String?      @unique
  department   String?
  role         Role         @default(USER)
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  externalId   String?
  active       Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  defaultDeliverySiteId     String?
  defaultDeliverySite       DeliverySite? @relation("UserDefaultDeliverySite", fields: [defaultDeliverySiteId], references: [id])
  defaultDeliverySiteLocked Boolean       @default(false)

  receptionSiteId           String?
  receptionSite             DeliverySite? @relation("UserReceptionSite", fields: [receptionSiteId], references: [id], onDelete: SetNull)

  orders       Order[]
  createdCycles MenuCycle[] @relation("CycleCreatedBy")
  auditLogs    AuditLog[]
  settingsUpdates AppSettings[] @relation("SettingsUpdatedBy")
  deliveryConfirmations DeliveryConfirmation[] @relation("DeliveryConfirmedBy")

  @@index([role])
  @@index([department])
  @@index([authProvider, externalId])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Restaurant {
  id          String   @id @default(cuid())
  code        String?  @unique
  name        String   @unique
  description String?
  cuisine     String?
  contactName String?
  contactPhone String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dishes      Dish[]

  @@index([active])
}

model Dish {
  id           String   @id @default(cuid())
  restaurantId String
  code         String?  @unique
  name         String
  description  String?
  priceSen     Int
  category     String?
  imageUrl     String?
  tags         String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@index([active])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Weekly cycle
// ---------------------------------------------------------------------------

model MenuCycle {
  id               String      @id @default(cuid())
  serviceWeekStart DateTime    @db.Date
  title            String?
  status           CycleStatus @default(DRAFT)

  orderOpenAt      DateTime
  orderCutoffAt    DateTime

  publishedAt      DateTime?
  subsidyRulesSnapshot Json?
  closedAt         DateTime?
  notes            String?

  createdById      String?
  createdBy        User?       @relation("CycleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  days             MenuDay[]
  orders           Order[]
  deliveryConfirmations DeliveryConfirmation[]

  @@index([status])
  @@index([orderOpenAt, orderCutoffAt])
  @@index([serviceWeekStart])
}

model MenuDay {
  id          String   @id @default(cuid())
  cycleId     String
  serviceDate DateTime @db.Date
  slot        MealSlot @default(LUNCH)
  note        String?

  cycle       MenuCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  @@unique([cycleId, serviceDate, slot])
  @@index([serviceDate])
}

model MenuItem {
  id          String  @id @default(cuid())
  menuDayId   String
  dishId      String
  priceSen    Int
  capacity    Int?
  sortOrder   Int     @default(0)

  menuDay     MenuDay    @relation(fields: [menuDayId], references: [id], onDelete: Cascade)
  dish        Dish       @relation(fields: [dishId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@unique([menuDayId, dishId])
  @@index([dishId])
}

// ---------------------------------------------------------------------------
// Subsidies
// ---------------------------------------------------------------------------

model SubsidyRule {
  id            String       @id @default(cuid())
  name          String
  type          SubsidyType
  value         Int
  capSen        Int?
  scope         SubsidyScope @default(ALL)
  department    String?
  priority      Int          @default(0)
  active        Boolean      @default(true)
  effectiveFrom DateTime?    @db.Date
  effectiveTo   DateTime?    @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([active, scope])
}

model DeliverySite {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  usersDefaultingHere User[] @relation("UserDefaultDeliverySite")
  receptionists User[] @relation("UserReceptionSite")
  deliveryConfirmations DeliveryConfirmation[]

  @@index([active])
}

model DeliveryConfirmation {
  id             String   @id @default(cuid())
  cycleId        String
  deliverySiteId String
  serviceDate    DateTime @db.Date

  expectedMeals  Int      @default(0)
  expectedOrders Int      @default(0)

  receivedAt     DateTime?
  receivedById   String?
  photoDataUrl   String?
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cycle          MenuCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  deliverySite   DeliverySite @relation(fields: [deliverySiteId], references: [id], onDelete: Cascade)
  receivedBy     User?        @relation("DeliveryConfirmedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([cycleId, deliverySiteId, serviceDate])
  @@index([cycleId])
  @@index([deliverySiteId])
  @@index([serviceDate])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  userId         String
  cycleId        String
  status         OrderStatus @default(CART)

  grossSen       Int         @default(0)
  subsidySen     Int         @default(0)
  netSen         Int         @default(0)

  subsidySnapshot Json?

  submittedAt    DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  deliverySiteId String?
  deliverySite   DeliverySite? @relation(fields: [deliverySiteId], references: [id])

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle          MenuCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  payments       Payment[]

  @@index([userId, cycleId])
  @@index([status])
  @@index([cycleId, status])
  @@index([paidAt])
  @@index([deliverySiteId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  menuItemId    String
  quantity      Int

  unitPriceSen  Int
  grossSen      Int
  subsidySen    Int      @default(0)
  netSen        Int      @default(0)

  serviceDate    DateTime @db.Date
  dishName       String
  restaurantName String

  /// Set when the employee taps "I received my meal", OR by the automatic
  /// sweep if they never confirmed it themselves. NULL = not yet confirmed.
  receivedAt       DateTime?
  /// true when receivedAt was written by the auto-confirm sweep,
  /// false when the employee confirmed it manually.
  receivedBySystem Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, menuItemId])
  @@index([serviceDate])
  @@index([menuItemId])
  @@index([serviceDate, receivedAt])
}

// ---------------------------------------------------------------------------
// Payments (HitPay)
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("hitpay")
  requestId         String?       @unique
  paymentId         String?
  status            PaymentStatus @default(PENDING)
  amountSen         Int
  currency          String        @default("MYR")
  checkoutUrl       String?
  paymentMethod     String?
  rawPayload        Json?
  failureReason     String?
  receiptEmail      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Site settings
// ---------------------------------------------------------------------------

model AppSettings {
  id                 String   @id

  siteName           String   @default("MR DIY Food Ordering")
  logoUrl            String?
  faviconUrl         String?
  supportEmail       String?
  maintenanceMessage String?

  /// Hour (0–23, in APP_TIMEZONE) after which unconfirmed PAID meal items
  /// are automatically marked as received on each service day.
  /// Default 18 = 6:00 PM. Editable by ADMIN in /admin/settings.
  mealReceiptCutoffHour Int @default(18)

  updatedAt          DateTime @updatedAt
  updatedById        String?

  updatedBy          User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
