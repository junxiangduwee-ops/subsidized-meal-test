// MR DIY Food Ordering System
//
// Money convention: every monetary column is an INTEGER number of *sen*
// (1 MYR = 100 sen). Integers avoid float drift and Decimal serialisation
// headaches across the server/client boundary. Format with lib/money.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Queries. On Supabase/Neon this is the transaction pooler (pgbouncer).
  url       = env("DATABASE_URL")
  // Schema changes. `db push` and migrations cannot run through a
  // transaction-mode pooler, so they need a direct/session connection.
  // scripts/prisma.mjs defaults this to DATABASE_URL when it is unset, so a
  // plain unpooled Postgres still works with only one variable.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ANALYTICS
  FINANCE
  RECEPTION
  USER
}

enum AuthProvider {
  LOCAL
  LDAP
  OIDC
  JOGET
}

/// DRAFT      - admin is still planning; invisible to users
/// PUBLISHED  - menu is locked-in and the ordering window is open
/// CLOSED     - cutoff passed; no further orders, kitchen counts are final
/// FULFILLED  - service week finished
/// CANCELLED  - cycle abandoned; paid orders must be refunded
enum CycleStatus {
  DRAFT
  PUBLISHED
  CLOSED
  FULFILLED
  CANCELLED
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
}

/// CART             - user is still building the order, nothing committed
/// AWAITING_PAYMENT - HitPay request created, waiting for webhook
/// PAID             - payment confirmed
/// CANCELLED        - user or admin cancelled before payment
/// REFUNDED         - money returned after payment
enum OrderStatus {
  CART
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// PERCENTAGE     - company pays `value` percent of the line price
/// FIXED_PER_ITEM - company pays up to `value` sen off each item
/// FIXED_PER_DAY  - company pays up to `value` sen across all items on one day
enum SubsidyType {
  PERCENTAGE
  FIXED_PER_ITEM
  FIXED_PER_DAY
}

enum SubsidyScope {
  ALL
  DEPARTMENT
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  /// Optional so an employee with no email account can still be provisioned
  /// off their employee code alone (see staffId). App code enforces "at
  /// least one of email or staffId" on every create/provision path - see
  /// lib/auth.ts and admin/users/actions.ts.
  email        String?      @unique
  name         String
  /// The employee code - #currentUser.employee.code# on the Joget side.
  /// The one identifier guaranteed to exist for every real employee, so
  /// it's tried first when matching a Joget/directory identity, and is
  /// the required fallback login identifier for anyone without an email.
  staffId      String?      @unique
  department   String?
  role         Role         @default(USER)
  /// Null for LDAP/OIDC accounts - those never hold a local credential.
  passwordHash String?
  authProvider AuthProvider @default(LOCAL)
  /// External subject id from LDAP (dn) or OIDC (sub).
  externalId   String?
  active       Boolean      @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  /// App-owned ordering preference, pre-fills a brand-new cart (see
  /// getOrCreateCart in lib/orders.ts). Deliberately NEVER touched by
  /// provisionFromDirectory() - Joget/LDAP/OIDC have no concept of this at
  /// all, so it must not be treated as identity data the way name/role are.
  /// Null until either an admin sets one (defaultDeliverySiteLocked = true,
  /// see admin/users) or the person has ordered at least once
  /// (defaultDeliverySiteLocked stays false, and it then auto-tracks their
  /// most recent choice - see setDeliverySite in lib/orders.ts).
  defaultDeliverySiteId     String?
  defaultDeliverySite       DeliverySite? @relation("UserDefaultDeliverySite", fields: [defaultDeliverySiteId], references: [id])
  /// true only when an admin explicitly picked a site in Admin -> Users.
  /// While locked, order-time site changes stop auto-updating the default
  /// (see setDeliverySite) - an admin-pinned value is never silently
  /// overwritten by someone ordering for a different site once. Clearing
  /// the field back to blank in Admin -> Users unlocks it again.
  defaultDeliverySiteLocked Boolean       @default(false)

  /// Restricts a RECEPTION account to confirming deliveries for one site
  /// only (enforced in reception/actions.ts, not just hidden in the UI).
  /// Null means this person can see and confirm every site - appropriate
  /// for someone covering several sites, but not the norm. Meaningless for
  /// any other role and always cleared back to null if the role changes
  /// away from RECEPTION (see admin/users/actions.ts).
  receptionSiteId           String?
  receptionSite             DeliverySite? @relation("UserReceptionSite", fields: [receptionSiteId], references: [id], onDelete: SetNull)

  orders       Order[]
  createdCycles MenuCycle[] @relation("CycleCreatedBy")
  auditLogs    AuditLog[]
  settingsUpdates AppSettings[] @relation("SettingsUpdatedBy")
  /// Deliveries this person (typically RECEPTION) has confirmed as arrived.
  deliveryConfirmations DeliveryConfirmation[] @relation("DeliveryConfirmedBy")

  @@index([role])
  @@index([department])
  @@index([authProvider, externalId])
}

// ---------------------------------------------------------------------------
// Catalogue - owned by ADMIN
// ---------------------------------------------------------------------------

model Restaurant {
  id          String   @id @default(cuid())
  /// Short, stable identifier (e.g. "R-001") admins can put in a CSV/Excel
  /// sheet to select this restaurant - unlike `name`, it never changes when
  /// the business is renamed. Used to validate weekly-menu imports.
  code        String?  @unique
  name        String   @unique
  description String?
  cuisine     String?
  contactName String?
  contactPhone String?
  address     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dishes      Dish[]

  @@index([active])
}

model Dish {
  id           String   @id @default(cuid())
  restaurantId String
  /// Short, stable identifier (e.g. "D-001"), unique across every dish in
  /// the catalogue (not just within its restaurant). Lets a weekly-menu
  /// CSV/Excel import reference an exact dish without relying on the
  /// (editable) name matching exactly.
  code         String?  @unique
  name         String
  description  String?
  /// Catalogue list price in sen. A MenuItem may override it for one cycle.
  priceSen     Int
  category     String?
  imageUrl     String?
  /// Free-form tags: "halal", "vegetarian", "contains-nuts", ...
  tags         String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@index([active])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Weekly cycle
// ---------------------------------------------------------------------------

model MenuCycle {
  id               String      @id @default(cuid())
  serviceWeekStart DateTime    @db.Date
  title            String?
  status           CycleStatus @default(DRAFT)

  orderOpenAt      DateTime
  orderCutoffAt    DateTime

  publishedAt      DateTime?
  subsidyRulesSnapshot Json?
  closedAt         DateTime?
  notes            String?

  createdById      String?
  createdBy        User?       @relation("CycleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  days             MenuDay[]
  orders           Order[]
  deliveryConfirmations DeliveryConfirmation[]

  @@index([status])
  @@index([orderOpenAt, orderCutoffAt])
  @@index([serviceWeekStart])
}

model MenuDay {
  id          String   @id @default(cuid())
  cycleId     String
  serviceDate DateTime @db.Date
  slot        MealSlot @default(LUNCH)
  note        String?

  cycle       MenuCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  items       MenuItem[]

  @@unique([cycleId, serviceDate, slot])
  @@index([serviceDate])
}

model MenuItem {
  id          String  @id @default(cuid())
  menuDayId   String
  dishId      String
  priceSen    Int
  capacity    Int?
  sortOrder   Int     @default(0)

  menuDay     MenuDay    @relation(fields: [menuDayId], references: [id], onDelete: Cascade)
  dish        Dish       @relation(fields: [dishId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@unique([menuDayId, dishId])
  @@index([dishId])
}

// ---------------------------------------------------------------------------
// Subsidies
// ---------------------------------------------------------------------------

model SubsidyRule {
  id            String       @id @default(cuid())
  name          String
  type          SubsidyType
  value         Int
  capSen        Int?
  scope         SubsidyScope @default(ALL)
  department    String?
  priority      Int          @default(0)
  active        Boolean      @default(true)
  effectiveFrom DateTime?    @db.Date
  effectiveTo   DateTime?    @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([active, scope])
}

model DeliverySite {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  usersDefaultingHere User[] @relation("UserDefaultDeliverySite")
  receptionists User[] @relation("UserReceptionSite")
  deliveryConfirmations DeliveryConfirmation[]

  @@index([active])
}

model DeliveryConfirmation {
  id             String   @id @default(cuid())
  cycleId        String
  deliverySiteId String
  serviceDate    DateTime @db.Date

  expectedMeals  Int      @default(0)
  expectedOrders Int      @default(0)

  receivedAt     DateTime?
  receivedById   String?
  photoDataUrl   String?
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cycle          MenuCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  deliverySite   DeliverySite @relation(fields: [deliverySiteId], references: [id], onDelete: Cascade)
  receivedBy     User?        @relation("DeliveryConfirmedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([cycleId, deliverySiteId, serviceDate])
  @@index([cycleId])
  @@index([deliverySiteId])
  @@index([serviceDate])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  userId         String
  cycleId        String
  status         OrderStatus @default(CART)

  grossSen       Int         @default(0)
  subsidySen     Int         @default(0)
  netSen         Int         @default(0)

  subsidySnapshot Json?

  submittedAt    DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  cancelReason   String?

  deliverySiteId String?
  deliverySite   DeliverySite? @relation(fields: [deliverySiteId], references: [id])

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle          MenuCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  items          OrderItem[]
  payments       Payment[]

  @@index([userId, cycleId])
  @@index([status])
  @@index([cycleId, status])
  @@index([paidAt])
  @@index([deliverySiteId])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  menuItemId    String
  quantity      Int

  unitPriceSen  Int
  grossSen      Int
  subsidySen    Int      @default(0)
  netSen        Int      @default(0)

  serviceDate    DateTime @db.Date
  dishName       String
  restaurantName String

  /// Set when the employee taps "I received my meal", OR by the automatic
  /// 18:00 sweep if they never confirmed it themselves. NULL = not yet confirmed.
  receivedAt       DateTime?
  /// true when receivedAt was written by the auto-confirm cron at 18:00,
  /// false when the employee confirmed it manually themselves.
  receivedBySystem Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, menuItemId])
  @@index([serviceDate])
  @@index([menuItemId])
  // Efficient sweep: only unconfirmed items, by service date
  @@index([serviceDate, receivedAt])
}

// ---------------------------------------------------------------------------
// Payments (HitPay)
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("hitpay")
  requestId         String?       @unique
  paymentId         String?
  status            PaymentStatus @default(PENDING)
  amountSen         Int
  currency          String        @default("MYR")
  checkoutUrl       String?
  paymentMethod     String?
  rawPayload        Json?
  failureReason     String?
  receiptEmail      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Site settings
// ---------------------------------------------------------------------------

model AppSettings {
  id                 String   @id
  siteName           String   @default("MR DIY Food Ordering")
  logoUrl            String?
  faviconUrl         String?
  supportEmail       String?
  maintenanceMessage String?
  updatedAt          DateTime @updatedAt
  updatedById        String?

  updatedBy          User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}
